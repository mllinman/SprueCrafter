# Railway Environment Variables Template
# Copy this file and set the values in Railway Dashboard

# ============================================
# REQUIRED - Core Configuration
# ============================================

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# JWT secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

# Environment
FLASK_ENV=production

# Database URL (automatically provided by Railway when you add PostgreSQL)
# DATABASE_URL=postgresql://...  # Railway sets this automatically

# ============================================
# REQUIRED - Stripe (for SaaS features)
# ============================================

# Get from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRO_PRICE_ID=price_

# ============================================
# OPTIONAL - Google OAuth
# ============================================

# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# OPTIONAL - Email (SMTP)
# ============================================

SMTP_SERVER=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@sprucecrafter.com

# ============================================
# OPTIONAL - AWS S3 (for file storage)
# ============================================

USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ============================================
# OPTIONAL - Monitoring
# ============================================

# Get from: https://sentry.io
SENTRY_DSN=

# Logging level
LOG_LEVEL=INFO

# ============================================
# OPTIONAL - Feature Flags
# ============================================

ENABLE_REGISTRATION=True
ENABLE_PHOTO_TO_MODEL=True
ENABLE_CLOUD_STORAGE=False

# ============================================
# OPTIONAL - CORS
# ============================================

# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-frontend-domain.com

# ============================================
# OPTIONAL - Rate Limiting
# ============================================

RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour
