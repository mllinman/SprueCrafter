# SprueCrafter Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Server Configuration
# ============================================
# Flask server host (use 0.0.0.0 for Railway deployment)
HOST=0.0.0.0
# Flask server port (Railway will set this automatically)
PORT=5000
# Flask debug mode (set to False for production)
FLASK_DEBUG=False

# Upload folder for temporary files (Railway provides /tmp)
UPLOAD_FOLDER=/tmp/sprucecrafter-uploads

# ============================================
# Optional: Pro Stripe Integration
# ============================================
# Only needed if you want to enable Pro subscriptions
# Leave blank to run without Pro features

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price ID for Pro subscription (get from https://dashboard.stripe.com/products)
STRIPE_PRO_PRICE_ID=

# URLs for Stripe checkout (update with your domain)
# For Railway: https://your-app.railway.app
STRIPE_SUCCESS_URL=https://your-app.railway.app/pro/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://your-app.railway.app/pro/cancel
STRIPE_RETURN_URL=https://your-app.railway.app

# ============================================
# Optional: Pre-configured Pro Users
# ============================================
# Comma-separated list of Pro users: api_key:name:email
# Example: abc123:John Doe:john@example.com,def456:Jane Smith:jane@example.com
PRO_USERS=

