{
  "name": "sprucecrafter",
  "version": "1.0.0",
  "description": "Professional 3D Model to Sprue Conversion Tool for Resin Printing",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:electron\"",
    "dev:backend": "python src/backend/app.py",
    "dev:electron": "electron . --dev",
    "dev:web": "set BACKEND_PORT=3000 && python src/backend/app_saas.py",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "lint": "eslint src/electron/**/*.js",
    "lint:fix": "eslint src/electron/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,css,html}\"",
    "test": "python test_installation.py --non-interactive"
  },
  "keywords": [
    "3d",
    "modeling",
    "sprue",
    "resin-printing",
    "scale-model"
  ],
  "author": "SprueCrafter Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "concurrently": "^9.1.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "three": "^0.172.0",
    "axios": "^1.12.0"
  },
  "build": {
    "appId": "com.sprucecrafter.app",
    "productName": "SprueCrafter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png"
    }
  }
}
