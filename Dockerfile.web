# Dockerfile.web - Web Application Container for SprueCrafter
# Production-ready Docker image for web deployment
#
# Build: docker build -f Dockerfile.web -t sprucecrafter-web .
# Run:   docker run -d -p 5000:5000 --name sprucecrafter sprucecrafter-web
# Test:  curl http://localhost:5000/api/health
#
# Environment variables can be overridden:
#   docker run -d -p 5000:5000 \
#     -e PORT=5000 \
#     -e FLASK_DEBUG=False \
#     -e UPLOAD_FOLDER=/tmp/sprucecrafter-uploads \
#     sprucecrafter-web

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies required for 3D processing
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
# Note: requirements.txt includes all production dependencies (gunicorn, etc.)
COPY requirements.txt ./
RUN pip install --no-cache-dir --trusted-host pypi.org --trusted-host files.pythonhosted.org -r requirements.txt

# Copy application source code
COPY src/ ./src/

# Create upload directory for temporary files
RUN mkdir -p /tmp/sprucecrafter-uploads

# Set environment variables
ENV HOST=0.0.0.0
ENV PORT=5000
ENV FLASK_DEBUG=False
ENV UPLOAD_FOLDER=/tmp/sprucecrafter-uploads
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/api/health')" || exit 1

# Run application with gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--timeout", "120", "--worker-class", "sync", "src.backend.app:app"]
